diff --git a/libwdi/winusb.inf.in b/libwdi/winusb.inf.in
--- a/libwdi/winusb.inf.in
+++ b/libwdi/winusb.inf.in
@@ -14,46 +14,21 @@
 Provider    = "libwdi"
 CatalogFile = #CAT_FILENAME#
 DriverVer   = #DRIVER_DATE#, #DRIVER_VERSION#
+PnpLockdown = 1
 
-[ClassInstall32]
-Addreg = WinUSBDeviceClassReg
-
-[WinUSBDeviceClassReg]
-HKR,,,0,"Universal Serial Bus devices"
-HKR,,Icon,,-20
-
 [Manufacturer]
-%VendorName% = libusbDevice_WinUSB,NTx86,NTamd64,NTarm64
-
-[libusbDevice_WinUSB.NTx86]
-%DeviceName% = USB_Install, USB\%DeviceID%
+%VendorName% = libusbDevice_WinUSB,NTamd64
 
