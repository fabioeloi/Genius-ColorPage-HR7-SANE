{
  "project": "Genius-ColorPage-HR7-SANE",
  "dirs": {
    "planning": "planning",
    "adr": "docs/adr",
    "plan": "docs/plan.md",
    "checkpoints": ".whw/checkpoints",
    "state": ".whw/state.db",
    "roles": "roles",
    "templates": "templates",
    "skills": "skills"
  },
  "gates": {
    "tiers": {
      "pr": [
        "planning-coverage",
        "adr-link",
        "wave-sync",
        "readme-sync",
        "agents-parity",
        "no-secrets"
      ],
      "ops": [
        "program-inventory",
        "evidence-quality",
        "release-readiness"
      ]
    },
    "custom": []
  },
  "evaluate": {
    "phaseA": [],
    "threshold": 3.5,
    "criteria": [
      {
        "id": "technical-quality",
        "weight": 1.3
      },
      {
        "id": "originality",
        "weight": 1.3
      },
      {
        "id": "craft",
        "weight": 1
      },
      {
        "id": "functionality",
        "weight": 1
      }
    ]
  },
  "conventions": {
    "branch": "{type}/wave-{nnn}-{slug}-{letter}",
    "commit": "{type}({scope}): {summary} (Wave {nnn} {letter})",
    "waveLetters": [
      "A",
      "B",
      "C",
      "D",
      "E"
    ]
  },
  "runners": {
    "default": null
  },
  "escalation": {
    "tiers": [],
    "maxFailuresDefault": 2
  },
  "hooks": {}
}
